# MedLens environment — copy to .env and fill in. Never commit .env.
# Postgres connection string (free tier: neon.tech works well).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Groq API key (free tier) — server-only, never NEXT_PUBLIC. https://console.groq.com
GROQ_API_KEY=""
# Groq model (free best versatile model; structured-output capable).
GROQ_MODEL="llama-3.3-70b-versatile"