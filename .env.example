# MedLens environment — copy to .env and fill in. Never commit .env.
# Postgres connection string (managed Postgres in production, e.g. Cloud SQL).
DATABASE_URL="postgresql://user:password@localhost:5432/medlens?schema=public"
# Google Gemini API key (server-only, never NEXT_PUBLIC).
GEMINI_API_KEY=""
# Explicit model name chosen after a real structured-output smoke test.
GEMINI_MODEL="gemini-2.5-flash"