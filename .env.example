# MedLens environment — copy to .env and fill in. Never commit .env.
# Postgres connection string (free tier: neon.tech works well).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Groq API key (free tier) — server-only, never NEXT_PUBLIC. https://console.groq.com
GROQ_API_KEY=""
# Groq model — verified live via scripts/groq-smoke.mjs.
# NOTE: llama-3.3-70b-versatile was RETIRED by Groq (404 model_not_found).
GROQ_MODEL="openai/gpt-oss-120b"